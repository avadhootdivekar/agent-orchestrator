{
  "name": "offline-rpg",
  "version": "1.0.0",
  "private": true,
  "description": "Single-player, offline, top-down 2D hack-and-slash RPG (Canvas 2D, plain JavaScript, zero dependencies).",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node scripts/build.mjs --verify && npm run test:unit",
    "test:unit": "node --test 'tests/**/*.test.js' 'tests/scripts/*.test.mjs'",
    "bench": "node scripts/bench.mjs",
    "balance": "node scripts/balance.mjs",
    "check-offline": "node scripts/check-offline.mjs dist/index.html",
    "check-all": "node scripts/run-all-checks.mjs"
  }
}
