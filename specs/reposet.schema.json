{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator/specs/reposet.schema.json",
  "title": "RepoSets",
  "description": "Named bindings of the orchestrator to multiple repos. One config may hold many sets; the orchestrator can drive different repo sets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo_sets"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "repo_sets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/repoSet" }
    }
  },
  "$defs": {
    "repoSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos", "workspace_root"],
      "properties": {
        "description": { "type": "string" },
        "workspace_root": { "type": "string", "description": "Base dir for resolving workspace-relative artifact paths." },
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
              "path": { "type": "string" },
              "role": { "enum": ["primary", "support"], "default": "support" }
            }
          }
        }
      }
    }
  }
}
