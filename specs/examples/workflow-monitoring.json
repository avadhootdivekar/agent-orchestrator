{
  "version": "1.0",
  "id": "monitored-pipeline-workflow",
  "name": "Design -> implement -> test pipeline with monitored guardrails",
  "repo_set": "default-set",
  "tasks": [
    {
      "id": "design",
      "agent": "architect",
      "instruction": "specs/examples/instructions/design.md",
      "outputs": ["output/design.md"]
    },
    {
      "id": "implement",
      "agent": "developer",
      "instruction": "specs/examples/instructions/implement.md",
      "depends_on": ["design"],
      "outputs": ["output/implementation.md"]
    },
    {
      "id": "test",
      "agent": "tester",
      "instruction": "specs/examples/instructions/test.md",
      "depends_on": ["implement"],
      "outputs": ["output/test-report.md"]
    }
  ],
  "circuit_breakers": [
    {
      "id": "cost-cap-negotiable",
      "condition": "run_cost_usd",
      "action": "stop",
      "threshold": 5.0,
      "mode": "recommend"
    },
    {
      "id": "operator-kill-switch-hard",
      "condition": "stop_file",
      "action": "stop",
      "path": "control/halt.flag",
      "mode": "hard"
    }
  ]
}
