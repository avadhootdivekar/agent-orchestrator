{
  "version": "1.0",
  "id": "repo-mutant-mini",
  "domain": "software",
  "tier": "large",
  "description": "Tier-2 repo-mutation mini suite (E-Bn7Dsc T-T2-5Ij6, HLD 4.2 / 2b-2c): 3 injected bugs and 1 excised feature on small pinned public Python repos (click, attrs, rich), each graded by hidden tests restored at grade time (pytest_targeted). The repos are checked out at pinned shas and re-snapshotted as a single commit; the bug/feature removal and hidden tests come from tasks/<id>/recipe.json. Variants: click = existing tests hidden (symptom report only); attrs-to-bool = hand-written hidden tests, no visible failing test; rich = visible failing tests + hidden boundary tests; attrs-excise = whole validators test module held out. See each recipe's `verified` record.",
  "defaults": {
    "timeout_seconds": 2400
  },
  "tasks": [
    {
      "id": "click-range-open-bounds",
      "category": "bugfix",
      "instruction": "tasks/click-range-open-bounds/instruction.md",
      "source": {
        "type": "repo_mutation",
        "repo": "https://github.com/pallets/click",
        "base_commit": "2247b35ea1c47c727d7a06e51fa280e12a863ff6",
        "recipe": "tasks/click-range-open-bounds/recipe.json"
      },
      "grader": {
        "type": "pytest_targeted"
      },
      "family": "repo-mutation",
      "language": "python",
      "tags": [
        "python",
        "inject",
        "click"
      ]
    },
    {
      "id": "attrs-to-bool-shorthand",
      "category": "bugfix",
      "instruction": "tasks/attrs-to-bool-shorthand/instruction.md",
