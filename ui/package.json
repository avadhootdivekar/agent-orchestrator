{
  "name": "agent-orchestrator-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser dashboard for the agent orchestrator. Builds into the Python package at src/agent_orchestrator/ui/static.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
