{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-orchestrator/specs/workflow.schema.json",
  "title": "Workflow",
  "description": "Declarative DAG spec for the agent-orchestrator. Payloads are referenced by path only; never inline file contents here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "repo_set", "tasks"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
    "name": { "type": "string" },
    "repo_set": { "type": "string", "description": "Key into the reposet config." },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retries": { "$ref": "#/$defs/retryPolicy" },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/trigger" },
      "default": [{ "type": "manual" }]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    },
    "loops": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/loop" }
    },
    "budget": { "$ref": "#/$defs/budget" },
    "branches": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/router" }
    },
    "circuit_breakers": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/circuitBreaker" }
    }
  },
  "$defs": {
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "default": 1 },
        "backoff_seconds": { "type": "number", "minimum": 0, "default": 0 }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["manual", "cron", "event"] },
        "schedule": { "type": "string", "description": "5/6-field cron expression; required when type=cron." },
        "timezone": { "type": "string", "default": "UTC" },
        "event": { "type": "string", "description": "Event key; required when type=event." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "cron" } } }, "then": { "required": ["schedule"] } },
        { "if": { "properties": { "type": { "const": "event" } } }, "then": { "required": ["event"] } }
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent", "instruction"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
        "agent": { "type": "string", "description": "Key into the agents registry." },
        "instruction": { "type": "string", "description": "PATH to a prompt/spec file. Never inline contents." },
        "inputs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "outputs": { "type": "array", "items": { "type": "string" }, "default": [] },
        "output_manifest": {
          "type": "string",
          "description": "Optional path to a JSON manifest the agent writes after completion. Format: {\"artifacts\": [\"path1\", ...]}. The engine reads it and passes the listed paths as {dynamic_inputs} to dependent tasks."
        },
        "depends_on": { "type": "array", "items": { "type": "string" }, "default": [] },
        "retries": { "$ref": "#/$defs/retryPolicy" },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "skip_if_outputs_exist": { "type": "boolean", "default": true },
        "emit_tasks": {
          "type": "boolean",
          "default": false,
          "description": "When true, the task writes a task manifest at task_manifest_path; the engine injects the listed tasks at run time (Area 2 dynamic injection)."
        },
        "task_manifest_path": {
          "type": "string",
          "description": "PATH to a JSON file {\"tasks\":[<TaskSpec>...]} written by an emit_tasks task; engine injects these at run time. Required when emit_tasks=true."
        },
        "join": {
          "enum": ["all", "any"],
          "default": "all",
          "description": "Convergence policy when a task depends on tasks from >1 route."
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "body", "gate_task_id", "gate_output_path"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_]*$",
          "description": "Loop id; namespaces cloned iteration tasks."
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Ordered task ids forming one iteration of the loop body."
        },
        "gate_task_id": {
          "type": "string",
          "description": "Id of the body task whose JSON output decides continue/stop."
        },
        "gate_output_path": {
          "type": "string",
          "description": "PATH to the JSON control file the gate task writes. Format: {\"continue\": true|false}. Suffixed per iteration by the engine."
        },
        "gate_field": {
          "type": "string",
          "default": "continue",
          "description": "Boolean field name read from the gate JSON file."
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Hard cap on the number of iterations; loop stops cleanly when reached."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_tokens": { "type": "integer", "minimum": 1 },
        "rate": { "$ref": "#/$defs/rateLimit" },
        "on_exhaustion": { "enum": ["stop", "wait"], "default": "stop" },
        "estimator": { "$ref": "#/$defs/estimatorConfig" }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens"],
      "properties": {
        "tokens": { "type": "integer", "minimum": 1 },
        "window": { "enum": ["minute", "ten_minutes", "hour"] },
        "window_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "estimatorConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chars_per_token": { "type": "integer", "minimum": 1, "default": 4 },
        "pessimism_buffer": { "type": "number", "minimum": 1.0, "default": 1.3 },
        "output_allowance_tokens": { "type": "integer", "minimum": 0, "default": 1000 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Task ids that head this route; cone = their exclusive descendants."
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "router_task_id", "verdict_path", "routes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
        "router_task_id": { "type": "string", "description": "Task whose success triggers the route read." },
        "verdict_path": { "type": "string", "description": "PATH to {\"routes\":[...]} written by the router task." },
        "verdict_field": { "type": "string", "default": "routes" },
        "routes": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/route" }
        },
        "default_route": {
          "type": ["string", "null"],
          "default": null,
          "description": "Route to select when the verdict is empty/unknown; null => unknown verdict fails the run."
        }
      }
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "action"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-_]*$" },
        "condition": {
          "enum": [
            "task_failures", "consecutive_failures", "run_wall_clock_seconds",
            "run_active_seconds",
            "verdict", "injected_task_count", "stop_file",
            "task_cost_usd", "run_cost_usd",
            "failure_ratio", "same_task_exhausted", "projected_cost_exceeds",
            "provider_429_count", "executor_spawn_failures", "output_validation_failures",
            "loop_max_iterations_no_converge", "no_artifact_progress_seconds",
            "injection_depth", "dag_size", "os_signal", "workspace_disk_usage",
            "git_workspace_dirty", "token_rate"
          ]
        },
        "action": { "enum": ["fail", "stop", "pause"] },
        "scope": { "enum": ["run"], "default": "run", "description": "'branch' reserved (non-MVP)." },
        "threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Count for task_failures/consecutive_failures/run_wall_clock_seconds/run_active_seconds/injected_task_count; USD amount for task_cost_usd/run_cost_usd (E-9h3m7k)."
        },
        "window": { "enum": ["run"], "default": "run", "description": "'branch'/'last_n' reserved (non-MVP)." },
        "task_id": { "type": "string", "description": "verdict condition: task whose verdict is read." },
        "verdict_path": { "type": "string", "description": "verdict condition: PATH to the verdict JSON." },
        "field": { "type": "string", "default": "halt", "description": "verdict condition: boolean field." },
        "path": { "type": "string", "description": "stop_file condition: PATH polled for existence." }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "condition": {
                "enum": [
                  "task_failures", "consecutive_failures", "run_wall_clock_seconds",
                  "run_active_seconds",
                  "injected_task_count", "task_cost_usd", "run_cost_usd"
                ]
              }
            }
          },
          "then": { "required": ["threshold"] }
        },
        {
          "if": { "properties": { "condition": { "const": "verdict" } } },
          "then": { "required": ["task_id", "verdict_path"] }
        },
        {
          "if": { "properties": { "condition": { "const": "stop_file" } } },
          "then": { "required": ["path"] }
        }
      ]
    }
  }
}
